# 土豆刷学习通 · 环境变量示例
# 复制成 .env 后填自己的值；.env 已在 .gitignore 里，不会被提交。
#
# 怎么让它生效：程序读的是**进程环境变量**，光放着 .env 文件不算数。
#   PowerShell : $env:CHX_LLM_KEY="sk-..."    （当前窗口有效）
#   bash       : export CHX_LLM_KEY=sk-...
# 优先级：config.ini 里填了非空值 > 这里的进程环境变量 > 代码默认值

# ============================================================
# 一、账号（只给云端那条链路用）
# ------------------------------------------------------------
# 这两个只有 .github/workflows/make_config.py（GitHub Actions 生成 config.ini）
# 会读；本地跑 python main.py 读的是 config.ini 或 -u / -p 命令行参数。
# username：11 位手机号，不带 +86、不带空格。
#           示例（示例值，换成自己的）：CHX_USER=13800000000
# password：登录密码，可以明文；云端建议放 GitHub Secrets，别写进文件。
#           示例（示例值，换成自己的）：CHX_PASS=your_password
#   ⚠ 密码里有 % 时，云端要写成两个 %%，例如 Abc%123 → Abc%%123。
CHX_USER=
CHX_PASS=

# ============================================================
# 二、答题引擎（TikuLLM，OpenAI 兼容接口）
# ------------------------------------------------------------
# 接口地址，必须带 /v1。DeepSeek / 硅基流动 / 自建 one-api / 中转站都行。
CHX_LLM_ENDPOINT=https://api.deepseek.com/v1

# API Key，示例 sk-xxxxxxxxxxxxxxxxxxxxxxxx —— 这是占位符，
# 换成自己在服务商后台申请的那一串。
CHX_LLM_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 模型名，必须和服务商模型列表里的写法完全一致
CHX_LLM_MODEL=deepseek-chat

# 访问大模型时的 http(s) 代理，留空 = 直连；不认 socks5://
CHX_LLM_PROXY=

# OpenAI 官方 SDK 也会读这个变量；只用 OpenAI 官方接口时填它，
# 第三方面板一般填上面的 CHX_LLM_KEY 就够了
OPENAI_API_KEY=

# ============================================================
# 三、可选调参（不写就用默认值）
# ------------------------------------------------------------
# CHX_LLM_TIMEOUT=90          # 单次请求超时秒数
# CHX_LLM_MAX_RETRIES=4       # 总尝试次数
# CHX_LLM_MIN_INTERVAL=1      # 两次调用最小间隔秒数
# CHX_LLM_TEMPERATURE=0.6     # 采样温度
# CHX_LLM_MAX_TOKENS=1024     # 单次返回上限
# CHX_LLM_SEED=               # 固定随机种子，便于复现
